# Điền giá trị THẬT vào 1 bản copy tên ".env" (không commit .env lên git).
# Claude không tự điền/biết các giá trị này — tự copy-paste từ tài khoản của bạn.

# Đăng nhập Eldorado (Cognito SRP) — lấy từ chính tài khoản seller
ELDORADO_EMAIL=
ELDORADO_PASSWORD=
# 2 giá trị này không phải secret (chỉ là ID cấu hình Cognito User Pool),
# nhưng vẫn để trống ở đây để bạn tự điền đúng theo tài khoản của mình.
ELDORADO_COGNITO_POOL_ID=
ELDORADO_COGNITO_CLIENT_ID=
ELDORADO_COGNITO_REGION=us-east-2

# Nội dung JSON của 1 Google Service Account (đã share quyền Editor vào các
# sheet cần đọc/ghi) — dán NGUYÊN VĂN nội dung file .json vào đây trên 1 dòng.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Sheet cấu hình sản phẩm chính (giữ nguyên sheet cũ nếu muốn dùng lại)
SHEET_CONFIG_ID=
CONFIG_RANGE=

# Vận hành
CONCURRENCY_LIMIT=5
LOOP_DELAY_SECONDS=30
PRODUCT_DELAY_SECONDS=1
ELDORADO_WRITE_DELAY_MS=300
ELDORADO_TIMEOUT_SECONDS=20

# AN TOÀN: mặc định true — chỉ tính toán + log, KHÔNG ghi giá thật lên
# Eldorado. Chỉ đổi thành false sau khi đã xem log vài chu kỳ thấy đúng.
DRY_RUN=true

# Tự cập nhật từ GitHub (xem updater.py) — sau mỗi chu kỳ, tool tự kiểm tra
# nhánh GIT_BRANCH trên remote "origin", nếu có commit mới sẽ tự
# `git pull --ff-only` rồi tự khởi động lại process. KHÔNG cần điền token gì
# ở đây — tool dùng lại chính git credential đã cache trên máy từ lần
# `git push` thủ công đầu tiên lên repo GitHub (repo private thì máy phải
# từng đăng nhập git với GitHub rồi).
GIT_BRANCH=master
UPDATE_CHECK_INTERVAL_SECONDS=300
